# Copy this to .env and fill in your values
# Never commit .env to git

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://tynhpwljqmxakcqfxsxt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Sentry (optional in dev; required in production)
EXPO_PUBLIC_SENTRY_DSN=

# Environment label ("development" | "staging" | "production")
EXPO_PUBLIC_ENV=development

# GIF search provider for social comment replies — OPTIONAL.
# The picker works without it: users can paste any GIF URL, and every GIF
# already used in a comment becomes a shared library everyone can pick from.
# Tenor closed its API to third parties on 2026-06-30; GIPHY describes API
# access as limited to select partners, so treat this as a nice-to-have.
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle and readable by
# anyone with the app — restrict any key you add.
EXPO_PUBLIC_GIPHY_API_KEY=
